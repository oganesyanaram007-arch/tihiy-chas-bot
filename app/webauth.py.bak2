# -*- coding: utf-8 -*-
"""Вход на сайте: e-mail + пароль. Telegram не требуется."""
from __future__ import annotations

import contextvars, datetime as dt, hashlib, hmac, re, secrets, time
from collections import defaultdict

from fastapi import APIRouter, HTTPException, Request, Response
from pydantic import BaseModel, Field
from sqlalchemy import func, select

from .db import Session, User, WebSession
from .models_partner import Partner, PartnerUser

router = APIRouter(prefix="/api/auth", tags=["webauth"])

COOKIE = "tc_web"
SESSION_DAYS = 30
WEB_ID_BASE = 700_000_000_000
ROUNDS = 240_000
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s.]+\.[A-Za-z]{2,}$")

_cookie: contextvars.ContextVar[str] = contextvars.ContextVar("tc_web", default="")


class WebCookieMiddleware:
    def __init__(self, app):
        self.app = app

    async def __call__(self, scope, receive, send):
        if scope.get("type") != "http":
            return await self.app(scope, receive, send)
        raw = ""
        for k, v in scope.get("headers", []):
            if k == b"cookie":
                raw = v.decode("latin-1")
                break
        token = ""
        for part in raw.split(";"):
            n, _, val = part.strip().partition("=")
            if n == COOKIE:
                token = val
                break
        ctx = _cookie.set(token)
        try:
            await self.app(scope, receive, send)
        finally:
            _cookie.reset(ctx)


def hash_password(p: str) -> str:
    salt = secrets.token_hex(16)
    dk = hashlib.pbkdf2_hmac("sha256", p.encode(), salt.encode(), ROUNDS)
    return f"pbkdf2${ROUNDS}${salt}${dk.hex()}"


def verify_password(p: str, stored: str | None) -> bool:
    if not stored:
        return False
    try:
        algo, rounds, salt, h = stored.split("$")
    except ValueError:
        return False
    if algo != "pbkdf2":
        return False
    dk = hashlib.pbkdf2_hmac("sha256", p.encode(), salt.encode(), int(rounds))
    return hmac.compare_digest(dk.hex(), h)


def _digest(v: str) -> str:
    return hashlib.sha256(v.encode()).hexdigest()


def client_ip(request: Request) -> str:
    return (request.headers.get("x-forwarded-for", "").split(",")[0].strip()
            or (request.client.host if request.client else ""))[:64]


_tries: dict[str, list[float]] = defaultdict(list)


def rate_ok(key: str, limit: int = 10, window: int = 600) -> bool:
    now = time.time()
    _tries[key] = [t for t in _tries[key] if now - t < window]
    if len(_tries[key]) >= limit:
        return False
    _tries[key].append(now)
    return True


async def _new_session(s, user_id: int, response: Response) -> None:
    token = secrets.token_urlsafe(32)
    now = dt.datetime.utcnow()
    s.add(WebSession(token_hash=_digest(token), user_id=user_id,
                     expires_at=now + dt.timedelta(days=SESSION_DAYS),
                     created_at=now))
    response.set_cookie(COOKIE, token, max_age=SESSION_DAYS * 86400,
                        httponly=True, secure=True, samesite="lax", path="/")


async def current_web_user() -> User:
    """Пользователь сайта из httpOnly-куки. 401, если сессии нет."""
    token = _cookie.get()
    if not token:
        raise HTTPException(status_code=401, detail="Нужен вход")
    now = dt.datetime.utcnow()
    async with Session() as s:
        sess = await s.scalar(select(WebSession).where(
            WebSession.token_hash == _digest(token)))
        if not sess or sess.expires_at < now:
            raise HTTPException(status_code=401, detail="Сессия истекла, войдите заново")
        user = await s.get(User, sess.user_id)
        if not user:
            raise HTTPException(status_code=401, detail="Пользователь не найден")
        sess.last_seen = now
        await s.commit()
        return user


class RegisterIn(BaseModel):
    email: str = Field(min_length=5, max_length=160)
    password: str = Field(min_length=6, max_length=128)
    name: str = Field(default="", max_length=120)
    phone: str = Field(default="", max_length=32)
    role: str = Field(default="guest")
    consent: bool = False


class LoginIn(BaseModel):
    email: str = Field(min_length=5, max_length=160)
    password: str = Field(min_length=1, max_length=128)


class ProfileIn(BaseModel):
    name: str = Field(default="", max_length=120)
    phone: str = Field(default="", max_length=32)


def _me(user: User, partner=None) -> dict:
    return {"id": user.id, "email": user.email or "", "name": user.name,
            "phone": user.phone or "", "role": user.role or "guest",
            "points": user.points, "partner_id": partner.id if partner else None,
            "partner_status": partner.status if partner else None}


@router.post("/register")
async def register(body: RegisterIn, request: Request, response: Response):
    email = body.email.strip().lower()
    if not EMAIL_RE.match(email):
        raise HTTPException(status_code=400, detail="Проверьте адрес почты")
    if body.role not in ("guest", "partner"):
        raise HTTPException(status_code=400, detail="Неизвестная роль")
    if not body.consent:
        raise HTTPException(status_code=400,
                            detail="Нужно принять оферту и политику конфиденциальности")
    ip = client_ip(request)
    if not rate_ok(f"reg:{ip}", limit=5):
        raise HTTPException(status_code=429, detail="Слишком много попыток, подождите")

    now = dt.datetime.utcnow()
    async with Session() as s:
        if await s.scalar(select(User).where(User.email == email)):
            raise HTTPException(status_code=409, detail="Такая почта уже зарегистрирована")
        top = await s.scalar(select(func.max(User.id)).where(User.id >= WEB_ID_BASE))
        uid = (top or WEB_ID_BASE) + 1
        name = body.name.strip() or email.split("@")[0]
        user = User(id=uid, name=name[:128], email=email,
                    password_hash=hash_password(body.password),
                    phone=body.phone.strip()[:32], role=body.role,
                    consent_at=now, consent_ip=ip)
        s.add(user)
        await s.flush()

        partner = None
        if body.role == "partner":
            partner = Partner(title=name[:160], status="new")
            s.add(partner)
            await s.flush()
            s.add(PartnerUser(tg_id=uid, partner_id=partner.id, name=name[:128],
                              phone=body.phone.strip()[:32], role="owner", active=True))
        await _new_session(s, uid, response)
        await s.commit()
        return {"ok": True, "user": _me(user, partner)}


@router.post("/login")
async def login(body: LoginIn, request: Request, response: Response):
    email = body.email.strip().lower()
    ip = client_ip(request)
    if not rate_ok(f"login:{ip}"):
        raise HTTPException(status_code=429, detail="Слишком много попыток, подождите 10 минут")
    async with Session() as s:
        user = await s.scalar(select(User).where(User.email == email))
        if not user or not verify_password(body.password, user.password_hash):
            raise HTTPException(status_code=401, detail="Неверная почта или пароль")
        partner = None
        if user.role == "partner":
            pu = await s.scalar(select(PartnerUser).where(PartnerUser.tg_id == user.id))
            if pu:
                partner = await s.get(Partner, pu.partner_id)
        await _new_session(s, user.id, response)
        await s.commit()
        return {"ok": True, "user": _me(user, partner)}


@router.post("/logout")
async def logout(response: Response):
    token = _cookie.get()
    if token:
        async with Session() as s:
            sess = await s.scalar(select(WebSession).where(
                WebSession.token_hash == _digest(token)))
            if sess:
                await s.delete(sess)
                await s.commit()
    response.delete_cookie(COOKIE, path="/")
    return {"ok": True}


@router.get("/me")
async def me():
    user = await current_web_user()
    partner = None
    if user.role == "partner":
        async with Session() as s:
            pu = await s.scalar(select(PartnerUser).where(PartnerUser.tg_id == user.id))
            if pu:
                partner = await s.get(Partner, pu.partner_id)
    return {"ok": True, "user": _me(user, partner)}


@router.patch("/profile")
async def update_profile(body: ProfileIn):
    user = await current_web_user()
    async with Session() as s:
        u = await s.get(User, user.id)
        if body.name.strip():
            u.name = body.name.strip()[:128]
        if body.phone.strip():
            u.phone = body.phone.strip()[:32]
            pu = await s.scalar(select(PartnerUser).where(PartnerUser.tg_id == u.id))
            if pu:
                pu.phone = u.phone
        await s.commit()
        return {"ok": True, "user": _me(u)}
