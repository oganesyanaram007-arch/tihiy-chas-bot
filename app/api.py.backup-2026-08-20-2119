# -*- coding: utf-8 -*-
"""HTTP API «Тихого Часа»: приём заявок партнёров с сайта.

Запуск отдельно от бота:
    .venv/bin/uvicorn app.api:api --host 0.0.0.0 --port 8080

На проде за nginx с HTTPS-сертификатом (обязательно: браузер не пустит
запрос с https-сайта на http-адрес).
"""
from __future__ import annotations

import html
import os
import re
import time
from collections import defaultdict

from aiogram import Bot
from aiogram.client.default import DefaultBotProperties
from aiogram.enums import ParseMode
from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field, field_validator

from .config import ADMIN_IDS, BOT_TOKEN
from .cabinet import router as cabinet_router
from .db import PartnerLead, Session, init_db
from . import models_partner  # noqa: F401  — регистрирует таблицы кабинета

# Домены, которым разрешено обращаться к API (наш сайт).
ALLOWED = [o for o in os.getenv(
    "CORS_ORIGINS",
    "https://tihiychas.ru,https://www.tihiychas.ru"
).split(",") if o]

from contextlib import asynccontextmanager


@asynccontextmanager
async def lifespan(_: FastAPI):
    await init_db()
    yield


api = FastAPI(title="Тихий Час — API", docs_url=None, redoc_url=None,
              lifespan=lifespan)
api.add_middleware(
    CORSMiddleware,
    allow_origins=ALLOWED or ["*"],
    allow_methods=["GET", "POST", "OPTIONS"],
    allow_headers=["Content-Type", "X-Init-Data"],
)

api.include_router(cabinet_router)
from .guest_api import router as guest_router
api.include_router(guest_router)

# Простейшая защита от спама: не более 5 заявок с одного IP за 10 минут.
_hits: dict[str, list[float]] = defaultdict(list)
RATE_N, RATE_WINDOW = 5, 600


def rate_ok(ip: str) -> bool:
    now = time.time()
    _hits[ip] = [t for t in _hits[ip] if now - t < RATE_WINDOW]
    if len(_hits[ip]) >= RATE_N:
        return False
    _hits[ip].append(now)
    return True


class Lead(BaseModel):
    name: str = Field(min_length=2, max_length=120)
    phone: str = Field(min_length=6, max_length=32)
    district: str = Field(default="", max_length=64)
    category: str = Field(default="", max_length=64)
    source: str = Field(default="site", max_length=16)
    # Honeypot: настоящие люди это поле не заполняют.
    website: str = Field(default="", max_length=100)

    @field_validator("phone")
    @classmethod
    def phone_has_digits(cls, v: str) -> str:
        if len(re.sub(r"\D", "", v)) < 10:
            raise ValueError("phone too short")
        return v


@api.post("/api/partner-lead")
async def partner_lead(lead: Lead, request: Request):
    ip = (request.headers.get("x-forwarded-for", "").split(",")[0].strip()
          or (request.client.host if request.client else "unknown"))

    if lead.website:                       # бот попался в honeypot
        return JSONResponse({"ok": True})  # молча принимаем, ничего не пишем
    if not rate_ok(ip):
        return JSONResponse({"ok": False, "error": "too_many"}, status_code=429)

    async with Session() as s:
        row = PartnerLead(
            tg_user=0,                     # заявка пришла с сайта, не из Telegram
            name=f"{lead.name} · {lead.district} · {lead.category}"[:128],
            phone=lead.phone,
        )
        s.add(row)
        await s.commit()
        lead_id = row.id

    if BOT_TOKEN and ADMIN_IDS:
        bot = Bot(BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
        text = (
            "🏪 <b>Заявка с сайта</b>\n\n"
            f"<b>{html.escape(lead.name)}</b>\n"
            f"Район: {html.escape(lead.district) or '—'}\n"
            f"Категория: {html.escape(lead.category) or '—'}\n"
            f"Телефон: <code>{html.escape(lead.phone)}</code>\n\n"
            f"Заявка #{lead_id} · /leads — весь список"
        )
        for admin in ADMIN_IDS:
            try:
                await bot.send_message(admin, text)
            except Exception:
                pass
        await bot.session.close()

    return {"ok": True, "id": lead_id}


@api.get("/api/health")
async def health():
    return {"ok": True}
